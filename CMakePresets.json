{
  "version": 10,
  "$comment": [
    "Install build tools: uv venv --python 3; uv pip install --upgrade -r requirements-dev.txt. Run commands with uv run --no-project.",
    "Run cmake --workflow --preset NAME to configure, build, and test a native target. Cross workflows only build.",
    "Outputs: build/<preset>/bin. Install with cmake --install build/<preset> --prefix dist --component tinyhook-runtime.",
    "Other install components: tinyhook-tools (th-compile), tinyhook-examples (Windows fixture), tinyhook-development (headers and CMake package).",
    "TINYHOOK_BUILD_APPS, TINYHOOK_BUILD_TESTS, TINYHOOK_BUILD_EXAMPLES, and TINYHOOK_INSTALL default on for top-level builds, off for add_subdirectory.",
    "TINYHOOK_WITH_LUAU enables host scripting; TINYHOOK_WITH_COMPILER enables source input; TINYHOOK_BUILD_COMPILER_TOOL builds th-compile.",
    "The tinyhook::core target exports headers. Consumers choose C++20 or newer and their own flags, optimization, and runtime linkage.",
    "For local overrides, use CMakeUserPresets.json (ignored by Git)."
  ],
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": true,
        "CMAKE_CXX_EXTENSIONS": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/bin",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/stage/${presetName}",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_CXX_SCAN_FOR_MODULES": false
      },
      "displayName": "Internal · Base",
      "$comment": [
        "Ninja, C++20, MinSizeRel, and separate output directories. Override settings in a user preset or on the configure command line."
      ]
    },
    {
      "name": "_fetch",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/infra/cmake/use-fetch-content.cmake"
      },
      "displayName": "Internal · Fetch dependencies",
      "$comment": [
        "Fetch revisions from dependencies.json into the build tree. The manifest also supplies generated THIRD_PARTY.md notices at configure time.",
        "For offline builds, set FETCHCONTENT_SOURCE_DIR_LUAU, FETCHCONTENT_SOURCE_DIR_SPDLOG, and (on Windows) FETCHCONTENT_SOURCE_DIR_MINHOOK to existing source trees.",
        "The provider installs full dependency licenses with runtime packages."
      ]
    },
    {
      "name": "_unix",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -ffunction-sections -fdata-sections"
      },
      "displayName": "Internal · Unix warnings"
    },
    {
      "name": "macos-small",
      "inherits": [
        "_base",
        "_fetch",
        "_unix"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-dead_strip",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "displayName": "macOS · Small",
      "$comment": [
        "Native host with Luau source support. CC and CXX select the compiler on first configure."
      ]
    },
    {
      "name": "macos-vm",
      "inherits": "macos-small",
      "cacheVariables": {
        "TINYHOOK_WITH_COMPILER": false,
        "TINYHOOK_BUILD_COMPILER_TOOL": true
      },
      "displayName": "macOS · VM-only runtime",
      "$comment": [
        "Bytecode-only host plus th-compile. Compile profiles with a tool built from the same Luau revision as the host."
      ]
    },
    {
      "name": "linux-small",
      "inherits": [
        "_base",
        "_fetch",
        "_unix"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "displayName": "Linux · Small",
      "$comment": [
        "Native host with Luau source support. Use CC=clang CXX=clang++ to select Clang on first configure."
      ]
    },
    {
      "name": "linux-relay",
      "inherits": [
        "linux-small"
      ],
      "cacheVariables": {
        "TINYHOOK_WITH_LUAU": false
      },
      "displayName": "Linux · Relay-only",
      "$comment": [
        "Transport-only host without Luau."
      ]
    },
    {
      "name": "linux-sanitize",
      "inherits": "linux-relay",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": false,
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "displayName": "Linux · ASan + UBSan",
      "$comment": [
        "Clang relay build with AddressSanitizer and UndefinedBehaviorSanitizer."
      ]
    },
    {
      "name": "system",
      "inherits": "_base",
      "displayName": "System packages",
      "$comment": [
        "Use installed packages: cmake --preset system -DCMAKE_PREFIX_PATH=/path/to/packages.",
        "Required targets: spdlog::spdlog; minhook::minhook on Windows; Luau::VM and Luau::Compiler for enabled host features.",
        "Luau upstream uses Luau.VM and Luau.Compiler. Packaged builds need aliases to the namespaced targets.",
        "Package-manager builds must arrange dependency license files through the package manager."
      ]
    },
    {
      "name": "windows-x86",
      "inherits": [
        "_base",
        "_fetch",
        "_unix"
      ],
      "toolchainFile": "${sourceDir}/infra/cmake/toolchains/mingw-x86.cmake",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++ -Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++ -Wl,--gc-sections",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": false,
        "CMAKE_CXX_FLAGS_MINSIZEREL": "-Os -DNDEBUG -fno-declone-ctor-dtor"
      },
      "displayName": "Windows x86 · MinGW",
      "$comment": [
        "Cross-compile x86 Windows helpers with MinGW. Use the helper and DLL matching the game architecture.",
        "Target gcc-ar/gcc-ranlib are required. If CMakeCache.txt contains macOS archive tools, configure in a fresh build directory.",
        "GCC PR125359 can cause unresolved std::string constructors under -Os; -fno-declone-ctor-dtor avoids it while retaining size optimization. IPO is disabled."
      ]
    },
    {
      "name": "msvc-x86",
      "inherits": [
        "_base",
        "_fetch"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /utf-8 /permissive- /EHsc",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "displayName": "Windows x86 · MSVC",
      "$comment": [
        "Run on Windows with Visual Studio 2022. Builds and tests x86 helpers."
      ]
    },
    {
      "name": "windows-x64",
      "inherits": [
        "_base",
        "_fetch",
        "_unix"
      ],
      "toolchainFile": "${sourceDir}/infra/cmake/toolchains/mingw-x64.cmake",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++ -Wl,--gc-sections",
        "CMAKE_SHARED_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++ -Wl,--gc-sections",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": false
      },
      "displayName": "Windows x64 · MinGW",
      "$comment": [
        "Cross-compile x64 Windows helpers with MinGW and static runtimes. IPO is disabled."
      ]
    },
    {
      "name": "msvc-x64",
      "inherits": [
        "_base",
        "_fetch"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/W4 /utf-8 /permissive- /EHsc",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "displayName": "Windows x64 · MSVC",
      "$comment": [
        "Run on Windows with Visual Studio 2022. Builds and tests x64 helpers."
      ]
    },
    {
      "name": "clang-x86",
      "inherits": [
        "_base",
        "_fetch"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_LINKER": "lld-link",
        "CMAKE_CXX_FLAGS": "/W4 /utf-8 /permissive- /EHsc",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "displayName": "Windows x86 · Clang",
      "$comment": [
        "Run in an x86 MSVC developer environment. clang-cl and LLD use the Windows SDK and static MSVC runtime."
      ]
    },
    {
      "name": "clang-x64",
      "inherits": [
        "_base",
        "_fetch"
      ],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-pc-windows-msvc",
        "CMAKE_LINKER": "lld-link",
        "CMAKE_CXX_FLAGS": "/W4 /utf-8 /permissive- /EHsc",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      },
      "displayName": "Windows x64 · Clang",
      "$comment": [
        "Run in an x64 MSVC developer environment. clang-cl and LLD use the Windows SDK and static MSVC runtime."
      ]
    }
  ],
