# Generate distribution notices from the same manifest used by the provider.
block()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/dependencies.json")
file(READ "${PROJECT_SOURCE_DIR}/dependencies.json" manifest)
set(notices "# Third-party software\n\nGenerated from dependencies.json by CMake.\nDependencies retain their own copyrights and licenses.\n\n")
string(JSON count LENGTH "${manifest}")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE "${last}")
        string(JSON package MEMBER "${manifest}" "${index}")
        foreach(field name git_repository git_tag license license_file)
            string(JSON ${field} GET "${manifest}" "${package}" "${field}")
        endforeach()
        string(REGEX REPLACE "\\.git$" "" url "${git_repository}")
        string(APPEND notices "## ${package}\n\nLicense: ${license}.\nSource: [${name}](${url}/tree/${git_tag}).\nRevision: `${git_tag}`.\nFull notices: [${license_file}](${url}/blob/${git_tag}/${license_file}).\n\n")
    endforeach()
endif()
string(APPEND notices "Runtime packages built with the dependency provider include the full license\nfiles for linked dependencies alongside this document. These files also contain\nany notices for bundled components.\n")
file(WRITE "${PROJECT_BINARY_DIR}/THIRD_PARTY.md" "${notices}")
endblock()
